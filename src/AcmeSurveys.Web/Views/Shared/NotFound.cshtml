@{
    ViewBag.Title = "No encontrado";
}
<div class="acme-status-page">
    <h1 class="h3">No encontramos lo que buscas</h1>
    <p class="text-muted">La página no existe o no tienes acceso a ella.</p>
    @if (Request.IsAuthenticated)
    {
        @Html.ActionLink("Volver a mis encuestas", "Index", "Surveys", null, new { @class = "btn btn-primary" })
    }
</div>
