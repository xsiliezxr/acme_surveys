@model AcmeSurveys.Application.Surveys.SurveyDetailsDto
@{
    ViewBag.Title = "Eliminar encuesta";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-body">
                <h1 class="h4">¿Eliminar "@Model.Name"?</h1>
                <p>El link público dejará de funcionar inmediatamente y la encuesta ya no aparecerá en su lista.</p>
                <p class="text-muted small">
                    Por trazabilidad, la eliminación es lógica: las respuestas recibidas se conservan cifradas
                    en la base de datos y no se exponen.
                </p>
                @using (Html.BeginForm("Delete", "Surveys", new { id = Model.ExternalId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>
