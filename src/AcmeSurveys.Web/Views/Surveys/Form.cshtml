@model SurveyFormViewModel
@{
    ViewBag.Title = Model.IsEdit ? "Editar encuesta" : "Nueva encuesta";
    var action = Model.IsEdit ? Url.Action("Edit", new { id = Model.ExternalId }) : Url.Action("Create");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewBag.Title</h1>
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-link" })
</div>

@if (Model.HasResponses)
{
    <div class="alert alert-warning" role="note">
        Esta encuesta ya tiene respuestas. Para no invalidar los resultados, los campos existentes no
        se pueden eliminar ni cambiar de tipo. Sí puede editar textos, el orden, si son requeridos, y agregar campos nuevos.
    </div>
}

<form method="post" action="@action">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.RowVersion)
    @Html.HiddenFor(m => m.HasResponses)
    @Html.ValidationSummary(true, null, new { @class = "alert alert-danger", role = "alert" })

    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label for="Name" class="form-label">Nombre de la encuesta</label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", required = "required", maxlength = SurveyRules.NameMaxLength })
                @Html.ValidationMessageFor(m => m.Name, null, new { @class = "text-danger small" })
            </div>
            <div>
                <label for="Description" class="form-label">Descripción <span class="text-muted small">(opcional)</span></label>
                @Html.TextAreaFor(m => m.Description, 3, 80, new { @class = "form-control", maxlength = SurveyRules.DescriptionMaxLength })
                @Html.ValidationMessageFor(m => m.Description, null, new { @class = "text-danger small" })
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h5 mb-0">Campos</h2>
        <span class="text-muted small">Máximo @SurveyRules.MaxFields campos</span>
    </div>
    @Html.ValidationMessage("Fields", new { @class = "d-block text-danger mb-2" })

    <div data-field-list data-max-fields="@SurveyRules.MaxFields">
        @for (var i = 0; i < Model.Fields.Count; i++)
        {
            @Html.Partial("_FieldRow", new FieldRowViewModel(i.ToString(), Model.Fields[i], Model.HasResponses))
        }
    </div>

    <template id="field-row-template">
        @Html.Partial("_FieldRow", new FieldRowViewModel(FieldRowViewModel.TemplateIndex, new FieldFormViewModel { Type = FieldType.Text }, false))
    </template>

    <button type="button" class="btn btn-outline-primary btn-sm mb-4" data-add-field>+ Agregar campo</button>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Guardar cambios" : "Crear encuesta")</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
</form>
