@using System.Globalization
@model AcmeSurveys.Application.Results.SurveyResultsDto
@{
    ViewBag.Title = "Resultados";
    var culture = CultureInfo.CurrentCulture;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Resultados</h1>
        <p class="text-muted mb-0">@Model.Name · @Model.TotalCount.ToString("N0", culture) respuesta(s)</p>
    </div>
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-link" })
</div>

@if (Model.TotalCount == 0)
{
    <div class="card text-center py-5">
        <div class="card-body">
            <p class="lead mb-1">Todavía no hay respuestas.</p>
            <p class="text-muted mb-0">Comparta el link público de la encuesta para empezar a recibirlas.</p>
        </div>
    </div>
}
else
{
    <div class="table-responsive card acme-table-scroll">
        <table class="table table-striped table-hover align-middle mb-0">
            <caption class="visually-hidden">Respuestas de la encuesta @Model.Name, página @Model.Page</caption>
            <thead class="table-light acme-sticky-head">
                <tr>
                    <th scope="col" class="text-nowrap">Fecha de envío</th>
                    @foreach (var column in Model.Columns)
                    {
                        <th scope="col">
                            @column.Title
                            <span class="d-block small text-muted fw-normal font-monospace">@column.Name</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="text-nowrap">
                            @ValueFormatter.FormatUtc(row.SubmittedAtUtc, culture)
                            @if (row.HasIntegrityError)
                            {
                                <span class="badge text-bg-danger" title="Un valor no superó la verificación de integridad y se ocultó">integridad</span>
                            }
                        </td>
                        @for (var i = 0; i < Model.Columns.Count; i++)
                        {
                            var value = row.Values[i];
                            <td class="@(Model.Columns[i].Type == FieldType.Number ? "text-end" : null) acme-cell">
                                @if (value == null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {

                                    <span class="acme-prewrap">@ValueFormatter.Format(value, culture)</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Paginación de resultados">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                    @Html.ActionLink("Anterior", "Results", new { id = Model.ExternalId, page = Model.Page - 1 }, new { @class = "page-link" })
                </li>
                <li class="page-item disabled"><span class="page-link">Página @Model.Page de @Model.TotalPages</span></li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                    @Html.ActionLink("Siguiente", "Results", new { id = Model.ExternalId, page = Model.Page + 1 }, new { @class = "page-link" })
                </li>
            </ul>
        </nav>
    }
}
