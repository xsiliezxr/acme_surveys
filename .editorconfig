root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,config,json,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = block_scoped
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false
# Campos privados con prefijo _
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# Usings sin uso: el IDE los marca y `dotnet format` los elimina.
dotnet_diagnostic.IDE0005.severity = suggestion

# Windows PowerShell 5.1 lee los .ps1 sin BOM como ANSI (los acentos salen corruptos).
[*.ps1]
charset = utf-8-bom
